// PiPL for Rive Shader — generated by build.sh from RiveShaderPiPL.r.in (flags computed from RiveShader.h,
// so they always agree with PF_Cmd_GLOBAL_SETUP, as the SDK requires). Compiled with Rez -useDF.
#include "AEConfig.h"
#include "AE_EffectVers.h"
#ifndef AE_OS_WIN
    #include <AE_General.r>
#endif

resource 'PiPL' (16000) {
    {
        Kind { AEEffect },
        Name { "@RS_NAME@" },
        Category { "@RS_CATEGORY@" },
        CodeMacARM64 { "EffectMain" },
        AE_PiPL_Version { 2, 0 },
        AE_Effect_Spec_Version { PF_PLUG_IN_VERSION, PF_PLUG_IN_SUBVERS },
        AE_Effect_Version { @RS_VERSION@ },
        AE_Effect_Info_Flags { 0 },
        AE_Effect_Global_OutFlags { @RS_OUT_FLAGS@ },
        AE_Effect_Global_OutFlags_2 { @RS_OUT_FLAGS2@ },
        AE_Effect_Match_Name { "@RS_MATCH_NAME@" },
        AE_Reserved_Info { 8 },
        AE_Effect_Support_URL { "@RS_SUPPORT_URL@" }
    }
};
