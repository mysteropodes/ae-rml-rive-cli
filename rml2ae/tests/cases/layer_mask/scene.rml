            <GradientStop position="1" colorValue="FFFFFFFF" id="0:26"/>
          </LinearGradient>
        </Fill>
      </Shape>
    </Node>
    <!-- 2. inverted alpha matte, source drawn (maskFlags 13 = invertedAlpha | isVisible | sourceDraws), a Shape -->
    <Node x="600" y="200" name="Card" id="0:30">
