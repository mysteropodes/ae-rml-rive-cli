      <Fill name="Fill" id="0:42">
        <SolidColor colorValue="80FFFFFF" name="Color" id="0:43"/>
      </Fill>
    </Shape>
    <LinearAnimation fps="25" duration="50" loopValue="loop" name="Masks" id="0:80">
      <KeyedObject objectId="0:20">
        <KeyedProperty propertyKey="13">
          <KeyFrameDouble value="100" frame="0" interpolationType="linear"/>
