<Rive version="1" kind="fragment">
  <!-- LayerMask cases: rml2ae turns them into native AE track mattes; CI verifies them with the Rive CLI -->
  <Artboard width="800" height="400" clip="true" defaultStateMachineId="0:90" name="Masks" id="0:1">
    <Fill name="Background">
      <SolidColor colorValue="FF20242C" name="Color"/>
    </Fill>
    <!-- 1. luma matte, source hidden (maskFlags 6 = luminance | isVisible): a sliding black-to-white ramp -->
